# Copy to .env only for local development.
DATAVIS_API_LOG_LEVEL=INFO
DATAVIS_API_STATE_DIR=/tmp/datavis-api

# Private API listener and service-to-service authentication.
DATAVIS_API_HOST=127.0.0.1
DATAVIS_API_PORT=8025
DATAVIS_API_API_TOKEN=
DATAVIS_DATASETS_PATH=config/datasets.yaml
DATAVIS_MAX_CSV_ROWS=100000
SPECIFY_SETTINGS_PATH=config/specify.yaml
SPECIFY_COLLECTION_ID=1
SPECIFY_USERNAME=
SPECIFY_PASSWORD=
