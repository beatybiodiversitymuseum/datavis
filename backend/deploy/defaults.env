# Repository-owned non-secret production defaults.
# Ansible supplies secrets and environment-specific allocations separately.
DATAVIS_API_LOG_LEVEL=INFO
DATAVIS_API_STATE_DIR=/var/lib/datavis-api
DATAVIS_CACHE_TTL_SECONDS=86400
DATAVIS_DATASETS_PATH=config/datasets.yaml
SPECIFY_SETTINGS_PATH=config/specify.yaml
